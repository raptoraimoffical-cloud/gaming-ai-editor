{
  "name": "gaming-ai-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && node scripts/launch.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check-desktop": "node scripts/launch.mjs scripts/check-desktop.cjs",
    "smoke:pokemon": "node scripts/smoke-pokemon.mjs",
    "verify:pokemon-animation": "node scripts/verify-pokemon-animation.mjs",
    "verify:pokemon-layouts": "node scripts/verify-pokemon-layouts.mjs",
    "check:pokemon-desktop": "node scripts/launch.mjs scripts/check-pokemon-desktop.cjs",
    "smoke:commons": "node scripts/smoke-commons.mjs",
    "check:commons-desktop": "node scripts/launch.mjs scripts/check-commons-desktop.cjs",
    "verify:layer-animation": "node scripts/verify-pokemon-animation.mjs --layers",
    "render:visual-sample": "node scripts/render-visual-sample.mjs",
    "smoke:reactions": "node scripts/smoke-reactions.mjs",
    "verify:reaction-sequence": "node scripts/verify-reaction-sequence.mjs",
    "verify:reaction-animation": "node scripts/verify-pokemon-animation.mjs --reaction",
    "check:reactions-desktop": "node scripts/launch.mjs scripts/check-reactions-desktop.cjs",
    "smoke:reaction-line": "node scripts/smoke-reaction-line.mjs",
    "verify:revisions": "node scripts/verify-revisions.mjs",
    "check:revisions-desktop": "node scripts/launch.mjs scripts/check-revisions-desktop.cjs",
    "verify:visual-quality": "node scripts/verify-visual-quality.mjs",
    "verify:quality-animation": "node scripts/verify-quality-animation.mjs",
    "check:visual-quality-desktop": "node scripts/launch.mjs scripts/check-visual-quality-desktop.cjs",
    "report:visual-quality": "\".runtime\\venv\\Scripts\\python.exe\" python/quality_report.py",
    "check:asset-revisions-desktop": "node scripts/launch.mjs scripts/check-asset-revisions-desktop.cjs",
    "check:asset-upload-desktop": "node scripts/launch.mjs scripts/check-asset-upload-desktop.cjs",
    "verify:revision-export": "\".runtime\\venv\\Scripts\\python.exe\" python/verify_revision_export.py",
    "verify:editor-modes": "node scripts/verify-editor-modes.mjs",
    "verify:quality-recovery": "node scripts/verify-quality-recovery.mjs",
    "check:quality-settings-desktop": "node scripts/launch.mjs scripts/check-quality-settings-desktop.cjs",
    "setup:local-models": "powershell -NoProfile -File scripts/setup-local-models.ps1",
    "assets:download": "\".runtime\\venv\\Scripts\\python.exe\" python/install_asset_pack.py --pack all",
    "check:game-assets-desktop": "node scripts/launch.mjs scripts/check-game-assets-desktop.cjs",
    "verify:game-assets-export": "node scripts/verify-game-asset-export.mjs",
    "verify:installed-ultra": "node scripts/verify-installed-ultra.mjs",
    "audit:desktop": "npm run build && node scripts/audit-desktop.mjs",
    "verify:google-live": "node scripts/launch.mjs scripts/verify-google-live.cjs",
    "verify:google-pipeline": "node scripts/verify-google-pipeline.mjs",
    "check:google-desktop": "node scripts/launch.mjs scripts/check-google-images-desktop.cjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/gif": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "ajv": "^8.20.0",
    "gifuct-js": "^2.1.2",
    "pngjs": "^7.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.534",
    "sharp": "^0.35.5",
    "sql.js": "^1.14.2",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^44.7.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.4"
  }
}
